{
  "name": "dsh-sub2api",
  "version": "0.1.6",
  "description": "Sub2API provider for DeepSeek Harness: zero-friction signup, auto-provisioned API key, upstream model sync, balance and recharge",
  "type": "module",
  "license": "GPL-3.0-only",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "cordis.patch.yml",
    "lib"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.2.3"
    }
  },
  "dependencies": {
    "@dsh-ai-providers/core": "0.7.0",
    "@dsh-ai-providers/openai-compatible": "0.7.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-web": ">=0.2.2-rc.1 <0.2.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-web": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.1-rc.2 <0.2.3"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sub2api",
    "provider",
    "llm",
    "relay",
    "gateway"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/edges.mjs && node test/client-load.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:edges": "node test/edges.mjs",
    "test:client": "node test/client-load.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
